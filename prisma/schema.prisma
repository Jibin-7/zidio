generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

enum Role {
  ADMIN
  ANALYST
  VIEWER
}

enum Sentiment {
  POS
  NEU
  NEG
}

enum Status {
  NEW
  REVIEWED
  ACTIONED
}

model Workspace {
  id        String     @id @default(uuid())
  name      String
  createdAt DateTime   @default(now())

  users     User[]
  feedbacks Feedback[]
  themes    Theme[]
  reports   Report[]
}

model User {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  passwordHash String
  role         Role      @default(VIEWER)
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  reports      Report[]
}

model Feedback {
  id             String    @id @default(uuid())
  content        String
  channel        String
  sourceRef      String?
  customerLabel  String?
  sentiment      Sentiment?
  sentimentScore Float?
  status         Status    @default(NEW)
  createdAt      DateTime  @default(now())
  workspaceId    String
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  themes         FeedbackTheme[]
  embedding      Embedding?
}

model Theme {
  id          String    @id @default(uuid())
  name        String
  description String?
  color       String?
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  feedbacks   FeedbackTheme[]
}

model FeedbackTheme {
  feedbackId String
  themeId    String
  confidence Float?

  feedback   Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  theme      Theme    @relation(fields: [themeId], references: [id], onDelete: Cascade)

  @@id([feedbackId, themeId])
}

model Embedding {
  id         String   @id @default(uuid())
  feedbackId String   @unique
  vector     Unsupported("vector(1536)")?

  feedback   Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
}

model Report {
  id           String    @id @default(uuid())
  title        String
  periodStart  DateTime
  periodEnd    DateTime
  contentJson  String
  createdAt    DateTime  @default(now())
  workspaceId  String
  generatedById String

  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  generatedBy  User      @relation(fields: [generatedById], references: [id], onDelete: Cascade)
}
